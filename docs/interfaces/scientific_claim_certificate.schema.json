{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arc.example/schemas/scientific-claim-certificate-0.1.json",
  "title": "ScientificClaimCertificate",
  "description": "Versioned interchange contract for claim-bounded scientific verification. It is a data interface, not a shared runtime dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "certificate_id",
    "natural_language_claim",
    "claim_strength",
    "scope",
    "modality",
    "assumptions",
    "physical_hypotheses",
    "competing_mechanisms",
    "observables",
    "evidence",
    "temporal_cutoff",
    "formal_obligations",
    "fidelity_review",
    "verifier_outputs",
    "discriminating_observations",
    "empirical_closure"
  ],
  "properties": {
    "schema_version": {"const": "scientific-claim-certificate-0.1"},
    "certificate_id": {"type": "string", "minLength": 1},
    "natural_language_claim": {"type": "string", "minLength": 1},
    "claim_strength": {"type": "string", "enum": ["descriptive", "associational", "predictive", "causal", "mechanistic", "universal"]},
    "scope": {"type": "string", "minLength": 1},
    "modality": {"type": "string", "enum": ["possible", "compatible", "likely", "sufficient", "necessary", "guaranteed"]},
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared", "candidate_hidden"],
      "properties": {
        "declared": {"type": "array", "items": {"type": "string"}},
        "candidate_hidden": {"type": "array", "items": {"type": "string"}}
      }
    },
    "physical_hypotheses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mechanism"}},
    "competing_mechanisms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mechanism"}},
    "observables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observable"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceItem"}},
    "temporal_cutoff": {"type": "string", "format": "date"},
    "formal_obligations": {"type": "array", "items": {"$ref": "#/$defs/formalObligation"}},
    "fidelity_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "dimensions", "reviewer_independent"],
      "properties": {
        "status": {"type": "string", "enum": ["pending", "passed", "failed"]},
        "dimensions": {"type": "array", "items": {"type": "string", "enum": ["subject", "observable", "direction", "quantifier", "modality", "scope", "assumptions", "reference_frame", "causal_strength"]}},
        "reviewer_independent": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "verifier_outputs": {"type": "array", "items": {"$ref": "#/$defs/verifierOutput"}},
    "discriminating_observations": {"type": "array", "items": {"type": "string"}},
    "empirical_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_ids"],
      "properties": {
        "status": {"type": "string", "enum": ["not_attempted", "planned", "inconclusive", "partially_closed", "closed"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  },
  "$defs": {
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "provenance"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "provenance": {"type": "string"}
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "quantity", "reference_frame"],
      "properties": {
        "id": {"type": "string"},
        "quantity": {"type": "string"},
        "unit": {"type": "string"},
        "reference_frame": {"type": "string"}
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citation", "first_public_date", "sha256", "available_to_verifier"],
      "properties": {
        "id": {"type": "string"},
        "citation": {"type": "string"},
        "first_public_date": {"type": "string", "format": "date"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "available_to_verifier": {"type": "boolean"},
        "role": {"type": "string", "enum": ["claim_source", "pre_cutoff_evidence", "outcome_reference", "control"]}
      }
    },
    "formalObligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "statement", "source_node_ids"],
      "properties": {
        "id": {"type": "string"},
        "language": {"type": "string"},
        "statement": {"type": "string"},
        "source_node_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "verifierOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "status", "verdict", "reason", "receipt"],
      "properties": {
        "verifier": {"type": "string"},
        "status": {"type": "string", "enum": ["not_run", "completed", "error"]},
        "verdict": {"type": "string", "enum": ["accept", "qualify", "reject", "unavailable"]},
        "reason": {"type": "string"},
        "receipt": {"type": "string"}
      }
    }
  }
}

